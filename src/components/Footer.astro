---
const { lang = "en" } = Astro.props;
const year = new Date().getFullYear();
const text = lang === "en" ? `© ${year} Bridge Builders` : `© ${year} Bridge Builders`;
---

<footer class="bb-footer border-t border-[rgb(var(--border))] bg-[rgb(var(--bg))]">
  <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-[rgb(var(--muted))] transition-colors">
    {text}
  </div>
</footer>
