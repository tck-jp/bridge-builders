---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import { Mail } from "@lucide/astro";

const lang = "en";
const path = "/contact";
---

<BaseLayout title="Contact | Bridge Builders" lang={lang}>
  <Header lang={lang} path={path} />

  <main class="mx-auto max-w-5xl px-4 py-6">
    <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
    <p class="mt-3 text-[rgb(var(--muted))]">Reach out about partnerships, training requests, or general questions.</p>

    <section aria-labelledby="email" class="mt-10">
      <Card>
        <div class="relative overflow-hidden -m-6 p-6">
          {/* Decorative background icon (clipped by card) */}
          <Mail
            class="pointer-events-none absolute right-[-2.75rem] top-1/2 z-0 h-44 w-44 -translate-y-1/2 text-[rgb(var(--border))] opacity-40"
            aria-hidden="true"
          />

          <div class="relative z-10">
            <div class="space-y-1">
              <p id="email" class="text-sm font-semibold uppercase tracking-wide text-[rgb(var(--muted))]">Email</p>
              <p class="text-xl font-semibold tracking-tight text-[rgb(var(--fg))]">tckbridgebuilders@gmail.com</p>
              <p class="text-sm text-[rgb(var(--muted))]">Email is the easiest way to reach us.</p>
            </div>

            <div class="mt-6">
              <Button href="mailto:tckbridgebuilders@gmail.com?subject=Bridge%20Builders%20Inquiry" variant="primary">
                <span class="inline-flex items-center gap-2">
                  <Mail class="h-5 w-5" aria-hidden="true" />
                  Email
                </span>
              </Button>
            </div>
          </div>
        </div>
      </Card>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
