---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
const lang = "en";
const path = "/";
---

<BaseLayout
  title="Bridge Builders | Home"
  lang={lang}
  description="Bridge Builders is a nonprofit supporting Third Culture Kids (TCKs) through community, training, and resources."
>
  <Header lang={lang} path={path} />

  <main class="mx-auto max-w-5xl px-4 py-6">
    <!-- Hero -->
    <section class="py-10 md:py-14">
      <p class="text-sm font-medium text-[rgb(var(--muted))]">Third Culture Kids</p>

      <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
        Helping TCKs in Japan navigate life between cultures.
      </h1>

      <p class="mt-4 max-w-prose text-sm leading-relaxed text-[rgb(var(--muted))] md:text-base">
        Bridge Builders supports Third Culture Kids (TCKs) and the adults around them—parents, educators, and
        organizations—by providing practical resources, training, and community.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <Button href="/en/resources" variant="primary">Explore resources</Button>
        <Button href="/en/contact" variant="secondary">Get in touch</Button>
      </div>
    </section>

    <!-- What we do -->
    <section class="border-t border-[rgb(var(--border))] py-10">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">About Bridge Builders</h2>

      <div class="mt-4 max-w-prose space-y-4 text-sm leading-relaxed text-[rgb(var(--muted))] md:text-base">
        <p>
          Japan has a unique culture—and for many TCKs, that can bring real challenges.
        </p>
        <p>
          Some were raised overseas and, even as Japanese, struggle to feel at home in Japanese culture. Others have a
          different nationality but grew up in Japan—and whether they live in Japan or return to their parents’ country,
          they can still feel like an outsider.
        </p>
        <p>
          Bridge Builders comes alongside teens with third-culture backgrounds as they navigate life between cultures and
          identity questions, so they can move forward with clarity and live as themselves.
        </p>
      </div>

    </section>

    <!-- CTA -->
    <section class="py-10">
      <div class="rounded-2xl border border-[rgb(var(--border))] bg-[rgb(var(--surface))] p-6 shadow-[var(--shadow)]">
        <h2 class="text-2xl font-semibold tracking-tight">Join a training or seminar</h2>
        <p class="mt-2 max-w-2xl text-sm text-[rgb(var(--muted))]">
          Browse upcoming offerings and sign up. If you want a private training for your school or organization, contact
          us.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <Button href="/en/resources" variant="primary">See resources</Button>
          <Button href="/en/contact" variant="secondary">Request a training</Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
