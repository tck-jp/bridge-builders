---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const lang = "en";
const path = "/";
---

<BaseLayout
  title="Bridge Builders | Support for Third Culture Kids (TCKs) in Japan"
  lang={lang}
  description="Bridge Builders supports Third Culture Kids (TCKs) in Japan through community, training, and practical resources for teens, parents, and educators."
  canonicalPath="/en/"
  ogImage="/og/en-home.jpg"
>
  <Header lang={lang} path={path} />

  <main class="mx-auto max-w-5xl px-4 py-6">
    <!-- Hero -->
    <section class="py-10 md:py-14">
      <p class="text-sm font-medium text-[rgb(var(--muted))]">Bridge Builders</p>

      <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
        In the years that shape us, difference can become a bridge. Walking with TCK youth between cultures.
      </h1>

      <p class="mt-4 text-base text-[rgb(var(--muted))]">
        Bridge Builders supports Third Culture Kids (TCKs) and the adults around them—parents, educators, and
        organizations—by providing practical resources, training, and community.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <Button href="/en/contact" variant="primary">Get in touch</Button>
      </div>
    </section>

    <!-- What we do -->
    <section class="border-t border-[rgb(var(--border))] py-10">
      <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">About Bridge Builders</h2>

      <div class="mt-4 space-y-4 text-base text-[rgb(var(--muted))]">
        <p>Japan has a unique culture—and for many TCKs, that can bring real challenges.</p>
        <p>
          Some were raised overseas and, even as Japanese, struggle to feel at home in Japanese culture. Others have a
          different nationality but grew up in Japan—and whether they live in Japan or return to their parents’ country,
          they can still feel like an outsider.
        </p>
        <p>
          Bridge Builders comes alongside teens with third-culture backgrounds as they navigate life between cultures
          and identity questions, so they can move forward with clarity and live as themselves.
        </p>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
